    </ItemGroup>

    <ItemGroup>
        <Content Include="..\CatalogObject.Номенклатура.xsd" Link="CatalogObject.Номенклатура.xsd">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
